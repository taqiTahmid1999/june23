<html>
  <head>
    <title>{{ shop.name }}</title>
    {{ content_for_header }}
    {{ 'counter.js' | asset_url | script_tag }}
    <script src="{{ 'main.js' | asset_url }}" type="module"></script>
    <script src="{{ 'hello.js' |  asset_url }}" type="module"></script>
    <style>
      .box {
        padding: 4rem;
        border: 1px solid black;
        border-radius: 3px;
      }
      .odd {
        color: palevioletred;
      }
      .even {
        color: blueviolet;
      }
    </style>
  </head>
  <body>
    {{ content_for_layout }}
    <div x-data="{message: 'Hello World',count:0}" class="box">
      <p x-text="message"></p>
      <button @click="count++" x-text="count"></button>
    </div>
  </body>
</html>
